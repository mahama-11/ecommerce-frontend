# Dev Dockerfile: serves pre-built frontend assets from the local, already-verified dist directory.
FROM nginx:alpine

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache bash

WORKDIR /usr/share/nginx/html
RUN rm -rf ./*

COPY dist /usr/share/nginx/html
COPY deploy/ecommerce-nginx.conf /etc/nginx/conf.d/default.conf
# Some cached nginx:alpine-compatible base images do not include the official
# /etc/nginx/conf.d include. Force a tiny main config so SPA fallback rules are
# always loaded in Cloud dev/prod-near builds.
RUN printf 'events { worker_connections 1024; }\nhttp { include /etc/nginx/mime.types; default_type application/octet-stream; sendfile on; include /etc/nginx/conf.d/*.conf; }\n' > /etc/nginx/nginx.conf
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
