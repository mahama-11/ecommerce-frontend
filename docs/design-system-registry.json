  "storybook": {
    "config": ".storybook/main.ts",
    "required_for_active_components": true,
    "build_command": "npm run storybook:build",
    "required_business_states": [
      "long_chinese",
      "mobile",
      "selected",
      "disabled",
      "loading",
      "multiline",
      "extreme_sku",
      "empty",
      "error"
