{
  "name": "v-lf-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/ecommerce-eslint-baseline-gate.mjs",
    "quality:static": "node scripts/ecommerce-static-quality-gate.mjs",
    "layout:density": "node scripts/ecommerce-layout-density-gate.mjs",
    "frontend:ia": "node scripts/ecommerce-frontend-ia-gate.mjs",
    "frontend:burn-down": "node scripts/ecommerce-historical-page-burn-down.mjs",
    "governance:test": "node --test tests/governance/*.test.mjs",
    "acceptance:governance": "node scripts/ecommerce-acceptance-governance-gate.mjs",
    "design-system:check": "node scripts/ecommerce-design-system-registry-gate.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "test:e2e": "playwright test --project=chromium-smoke",
    "test:visual": "playwright test --project=chromium-visual-desktop --project=chromium-visual-tablet --project=chromium-visual-mobile",
    "api:contract": "node scripts/ecommerce-api-contract-gate.mjs",
    "contract:smoke": "node ../tools/contract-governance/scripts/run-adapter-smoke.mjs --config contract-adapter.config.json",
    "contract:evidence": "node ../tools/contract-governance/scripts/emit-adapter-evidence.mjs --config contract-adapter.config.json",
    "lighthouse:budget": "node scripts/ecommerce-lighthouse-budget.mjs",
    "bundle:budget": "node scripts/ecommerce-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "ci:quick": "npm run frontend:gate && npm run typecheck && npm run storybook:build && npm run build && npm run bundle:budget && npm run api:contract && npm run contract:breaking-check && npm run contract:smoke && npm run contract:evidence && npm run lighthouse:budget && npm run test:e2e && npm run test:visual",
    "smoke:auth": "node scripts/ecommerce-auth-smoke.mjs",
    "style:consistency": "node scripts/ecommerce-style-consistency.mjs",
    "style:repair-queue": "node scripts/ecommerce-style-drift-repair-queue.mjs",
    "frontend:evidence": "node scripts/ecommerce-frontend-visual-evidence.mjs",
    "runtime:layout": "node scripts/ecommerce-runtime-layout-gate.mjs",
    "frontend:gate": "node scripts/ecommerce-frontend-automation-gate.mjs",
    "preview": "vite preview",
    "build:preflight": "node scripts/ecommerce-build-preflight.mjs",
    "deploy:dev": "cd .. && bash tools/dev/ecommerce-frontend-dev-deploy.sh dev",
    "deploy:promote": "echo 'BLOCKED: prod promotion requires explicit approval; use /root/work/v/tools/dev/promote-cloud-dev-to-prod.sh --yes --apps ecom after release evidence' >&2; exit 2",
    "contract:diff": "node ../tools/contract-governance/scripts/classify-openapi-diff.mjs --base contracts/base/ecommerce.openapi.json --head contracts/ecommerce.openapi.json --out reports/contract-governance/contract-diff.json",
    "contract:breaking-check": "npm run contract:diff",
    "contract:generate": "npm run api:contract",
    "contract:check-generated": "npm run api:contract",
    "visual:composition": "node scripts/ecommerce-visual-composition-gate.mjs",
    "page:position": "node scripts/ecommerce-page-position-gate.mjs",
    "design:governance": "node scripts/ecommerce-design-governance-gate.mjs",
    "qa:business": "playwright test -c playwright.business.config.ts --project=chromium-business-runtime",
    "qa:business:mock": "npm run qa:business",
    "qa:changed-flow": "node scripts/ecommerce-business-qa-selector.mjs && npm run qa:business",
    "qa:report": "node scripts/ecommerce-business-qa-report.mjs",
    "qa:business:ci": "npm run qa:changed-flow && npm run qa:report",
    "qa:business:live": "node scripts/ecommerce-dev-live-mutating-qa.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:contract": "playwright test tests/e2e/contract --project=api-contract",
    "test:contract:real": "node scripts/ecommerce-real-contract-preflight.mjs",
    "ci:qa-gate": "npm run typecheck && npm run build && npm run test:unit:coverage && npm run test:contract && npm run test:contract:real && npm run qa:business && npm run qa:report && npm run qa:quality-dashboard",
    "ci:qa-gate:require-real": "ECOMMERCE_QA_REQUIRE_REAL=1 npm run ci:qa-gate",
    "qa:quality-dashboard": "node scripts/ecommerce-quality-dashboard.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.3",
    "axios": "^1.15.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.8"
  }
}
